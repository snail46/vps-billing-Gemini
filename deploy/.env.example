IMAGE_PREFIX=ghcr.io/snail46/vps-billing-gemini
IMAGE_TAG=latest

APP_ENV=production
APP_BASE_URL=http://localhost:8080
USER_WEB_ORIGIN=http://localhost:3000
ADMIN_WEB_ORIGIN=http://localhost:3001

POSTGRES_DB=vps_billing
POSTGRES_USER=vps_billing
POSTGRES_PASSWORD=your-secure-postgres-password
DATABASE_URL=postgres://vps_billing:your-secure-postgres-password@postgres:5432/vps_billing?sslmode=disable

REDIS_URL=redis://redis:6379/0

SESSION_SECRET=change-me-to-a-secure-random-32-byte-string
CSRF_SECRET=change-me-to-a-secure-random-32-byte-string
LOG_LEVEL=info
